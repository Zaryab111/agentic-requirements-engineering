{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequirementSchema",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "status",
    "confidence",
    "source",
    "lines",
    "evidence_quote",
    "assumptions"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "category": { "type": "string", "enum": ["Functional", "Non-Functional", "Constraint", "DomainRule"] },
    "status": { "type": "string", "enum": ["Pending_Review", "Approved", "Rejected"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "source": { "type": "string" },
    "lines": { "type": "string" },
    "evidence_quote": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  }
}
